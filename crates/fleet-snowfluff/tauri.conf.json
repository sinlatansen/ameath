{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fleet Snowfluff",
  "version": "0.1.0",
  "identifier": "fleet-snowfluff",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "deb", "appimage", "dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "Fleet Snowfluff Self-Signed"
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kagetsuki1997/fleet-snowfluff/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDlGOUU4QjE0NTRDNTNCOTcKUldTWE84VlVGSXVlbndaMnFnazB5OGVZU2VFWk5jc0cxMy81YnpScGNMYjBqd1dCMmgrbWhKakEK"
    }
  }
}
