{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fleet Snowfluff",
  "version": "0.1.0",
  "identifier": "io.github.kagetsuki1997.fleet-snowfluff",
  "build": {
    "frontendDist": "../../ui/dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "title": "Fleet Snowfluff",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
